# Shared
COMPOSE_PROJECT_NAME=aicos

# API
DATABASE_URL=postgresql+psycopg://aicos:aicos@localhost:5432/aicos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string
ENCRYPTION_KEY=change-me-32-byte-fernet-or-passphrase
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Optional default model provider keys (never commit real values)
# Prefer configuring keys in Settings → Models UI (encrypted at rest).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
